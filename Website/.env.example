# Newsletter (Brevo)
# 1. W Brevo: Contacts → Forms → utwórz formularz z Double confirmation email.
# 2. W Design usuń Cloudflare Turnstile (inaczej własny formularz na colgante.pl nie przejdzie).
# 3. Wklej action (https://….sibforms.com/serve/…). Pola: EMAIL, FIRSTNAME, OPT_IN.
# 4. npm run build && npm run deploy:ovh
PUBLIC_NEWSLETTER_FORM_ACTION=
PUBLIC_NEWSLETTER_EMAIL_FIELD=EMAIL
PUBLIC_NEWSLETTER_NAME_FIELD=FIRSTNAME
PUBLIC_NEWSLETTER_LOCALE=pl

# Deploy OVH — wyłącznie SFTP (port 22, szyfrowane SSH).
# Na hostingu WWW OVHcloud NIE ma pola „dodaj klucz SSH” w panelu.
# Logowanie = login FTP + hasło, ale przez SFTP (nie zwykły FTP na 21).
#
# SFTP: zaznacz „Aktywny” przy użytkowniku w Hosting → FTP - SSH.
OVH_SFTP_HOST=ftp.cluster129.hosting.ovh.net
OVH_SFTP_USER=colgane
OVH_SFTP_DIR=www
OVH_SFTP_PORT=22
OVH_SFTP_PASSWORD=

# Opcjonalnie: klucz, jeśli kiedyś zadziała authorized_keys na tym planie.
# OVH_SFTP_IDENTITY=~/.ssh/colgante_ovh
