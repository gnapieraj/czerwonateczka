---
import BaseLayout from "../layouts/BaseLayout.astro";

const stages = [
  ["Wokanda", "24 noce w dwóch sezonach: Mecenas (1–12) i Aplikant (13–24), numeracja ciągła. Kolejna otwiera się dopiero po stemplu poprzedniej, więc Aplikant czeka na koniec Mecenasa. Noc ze stemplem zagrasz jeszcze raz."],
  ["Biblia wizualna", "Obsada i stały wygląd bohaterów. To orientacja w fabule, nie materiał prawny."],
  ["Komiks", "Dwa kadry. Na iPhonie termin, kontekst i pytanie są następną stroną; na iPadzie leżą pod kadrami. Nie ujawnia rozwiązania."],
  ["Teczka", "Ruch na przedmiocie nocy. Zwykle jeden ruch kończy noc; w kilku nocach najpierw zaznaczasz, potem domykasz na dole. Wynik jest jeden z trzech: trafny, błędny albo niepełny."],
  ["Werdykt", "Jedna plansza: stempel TRAFNE, BŁĘDNE albo NIEPEŁNE, raz, pod nim refleks i czerwona lampka."],
  ["Briefing", "Obowiązkowy po werdykcie: jak to działa, na co uważać, jak minimalizować, praktyka w kancelarii. Na dole „Kończymy na dziś” — albo, w tym samym sezonie, jeszcze jedna noc."],
  ["Koniec dnia", "Jedna noc dziennie to rytm, nie blokada. Biurko pokazuje „Na dziś wystarczy”. Przypomnienie jest opcjonalne: dzień roboczy, wybrana godzina (domyślnie 17:30), bez dźwięku."],
  ["Nawyki", "Każda noc ze stemplem zapala nazwany nawyk na biurku — 12 na sezon. Karta nawyku wraca następnego dnia, po trzech kolejnych nocach i na koniec sezonu. Najwyżej jedna dziennie."],
  ["Raport", "W ustawieniach. Sezon z ≥ 90% TRAFNE i przeczytanymi briefingami daje dyplom PDF, CSV, JSON i odznakę PNG dla pracodawcy. Pliki powstają na urządzeniu; nic nie wychodzi samo."],
  ["Źródła", "Tematy to codzienne zagrożenia biurowe w duchu SANS OUCH!, bez odniesień do konkretnych wydań. Sceny i Colgante są fikcją; kadry komiksu to ilustracje do tej historii, nie dokumentacja z kancelarii."],
];

const ratio = [
  ["Werdykt", "TRAFNE / BŁĘDNE / NIEPEŁNE — ocena ruchu w scenariuszu, nie wyrok w sprawie klienta."],
  ["Refleks", "Praktyczny nawyk do zastosowania następnym razem."],
  ["Briefing", "Co chronić, na co uważać, jak minimalizować i jak wygląda to w kancelarii."],
  ["Czerwona lampka", "Fakt, przy którym należało zatrzymać automatyzm i zweryfikować sytuację."],
];
---

<BaseLayout title="Jak czytać grę">
  <section class="reading section">
    <p class="eyebrow">SŁOWNIK EKRANÓW</p>
    <h1>Jak czytać grę</h1>
    <ol class="check-list">
      {stages.map(([name, description]) => (
        <li><strong>{name}:</strong> {description}</li>
      ))}
    </ol>
  </section>

  <section class="shell section-sm">
    <div class="section-heading">
      <div>
        <p class="eyebrow">DWANAŚCIE NAWYKÓW</p>
        <h2>Ślad nocy, nie ocena prawna</h2>
      </div>
      <p class="muted">
        Na wokandzie każda noc zostawia nazwany nawyk. Stempel zapala nazwę.
        To nie jest punktacja prawna. Na biurku widać też: akta, instalacja,
        opłata, rachunek, głos, dokument, dostęp i okup.
      </p>
    </div>
    <div class="card-grid">
      <article class="ink-card"><h3>Logowanie</h3><p class="muted">Drugie zatwierdzenie. Zatwierdzasz tylko własne hasło.</p></article>
      <article class="ink-card"><h3>Pismo</h3><p class="muted">Doklejony plik. Pismo bierzesz z portalu, nie z przesłanego maila.</p></article>
      <article class="ink-card"><h3>Asystent</h3><p class="muted">Ugoda w narzędziu. Do asystenta idzie układ, nie akta sprawy.</p></article>
      <article class="ink-card"><h3>Kanał</h3><p class="muted">Hasło i link. Osobna rozmowa, nie ta sama odpowiedź.</p></article>
    </div>
  </section>

  <section class="reading section">
    <p class="eyebrow">PO DECYZJI</p>
    <h2>Co zostaje z nocy</h2>
    <ul class="flag-list">
      {ratio.map(([name, description]) => (
        <li><strong>{name}:</strong> {description}</li>
      ))}
    </ul>
    <div class="paper-card">
      <p><strong>Najczęstsze pomyłki:</strong></p>
      <p>
        Głos wewnętrzny jest pytaniem <em>przed</em> wyborem, a refleks — nawykiem
        <em>po</em> wyborze. Stempel, refleks i lampka są na jednej planszy;
        briefing jest potem. Następnego dnia, zanim otworzysz teczkę, karta pokazuje
        najpierw lampkę, a nawyk odsłaniasz sam. Stempel na wokandzie zapisuje wynik
        nocy; kolejna teczka otwiera się dopiero po nim.
      </p>
    </div>
  </section>
</BaseLayout>
