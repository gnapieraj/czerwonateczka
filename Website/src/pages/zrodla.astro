---
import { contentMeta, sources } from "../data/content";
import BaseLayout from "../layouts/BaseLayout.astro";

const categories = [...new Set(sources.map((source) => source.category.pl))];
---

<BaseLayout
  title="Źródła"
  description="Bibliografia Czerwonej Teczki: prawo, etyka, wytyczne i publiczne przykłady."
>
  <section class="shell section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">BIBLIOGRAFIA / {contentMeta.sourceCount} POZYCJE</p>
        <h1>Źródła</h1>
      </div>
      <p class="muted">
        Stan prawa i źródeł: {contentMeta.legalState}. Przykłady zagraniczne są
        ilustracjami i nie stanowią polskiego precedensu.
      </p>
    </div>
    {categories.map((category) => (
      <section class="section-sm">
        <h2 style="font-size: 2rem">{category}</h2>
        <div class="source-grid">
          {sources.filter((source) => source.category.pl === category).map((source) => (
            <article class="source-card">
              <a href={source.url} rel="external noopener">{source.title.pl} ↗</a>
              <p>{source.note.pl}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </section>
</BaseLayout>
