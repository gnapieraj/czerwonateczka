---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Teczki nie znaleziono" noindex>
  <section class="reading section">
    <p class="eyebrow">BŁĘDNA SYGNATURA / 404</p>
    <h1>Tej teczki nie ma na wokandzie.</h1>
    <p class="lead">
      Sprawdź adres albo wróć do biurka. Sama wiarygodnie brzmiąca sygnatura nie
      wystarcza.
    </p>
    <div class="actions">
      <a class="button" href="/wokanda">Wróć na wokandę →</a>
      <a class="button button-secondary" href="/">Strona główna</a>
    </div>
  </section>
</BaseLayout>
