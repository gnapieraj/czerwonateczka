---
import DocketCard from "../../components/DocketCard.astro";
import { lessons } from "../../data/content";
import { deskClasses } from "../../data/site";
import BaseLayout from "../../layouts/BaseLayout.astro";

const seasons = [
  {
    id: "0",
    title: "Sezon mecenasa",
    note: "Noce 01–12. Fotel przy oknie.",
  },
  {
    id: "1",
    title: "Sezon aplikanta",
    note: "Noce 13–24. Kadry są w przygotowaniu.",
  },
];
---

<BaseLayout
  title="Wokanda"
  description="Dwadzieścia cztery edukacyjne noce w dwóch sezonach: najpierw fotel mecenasa, potem krzesło aplikanta. Kadry Sezonu 1 są w przygotowaniu."
>
  <section class="shell section-sm">
    <p class="eyebrow">BIURKO / DWA SEZONY</p>
    <h1>Wokanda</h1>
    <p class="lead">
      Dwadzieścia cztery noce. Sezon mecenasa jest do zagrania. Kadry Sezonu 1
      są w przygotowaniu. To nie test wiedzy z jedną magiczną odpowiedzią.
    </p>
    <div class="actions no-print" aria-label="Filtry klas">
      <button class="button button-secondary" type="button" data-filter="all" aria-pressed="true">Wszystkie</button>
      {deskClasses.map((name) => (
        <button class="button button-quiet" type="button" data-filter={name} aria-pressed="false">
          {name}
        </button>
      ))}
    </div>
  </section>

  {seasons.map((season) => (
    <section class="shell section-sm" data-season>
      <h2>{season.title}</h2>
      <p class="muted">{season.note}</p>
      <div class="docket-grid" data-docket-grid>
        {lessons.filter((lesson) => lesson.seasonId === season.id).map((lesson) => (
          <DocketCard lesson={lesson} />
        ))}
      </div>
    </section>
  ))}
  <p class="shell form-status" data-filter-status aria-live="polite"></p>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
  const items = Array.from(document.querySelectorAll<HTMLElement>("[data-desk]"));
  const seasons = Array.from(document.querySelectorAll<HTMLElement>("[data-season]"));
  const status = document.querySelector<HTMLElement>("[data-filter-status]");

  for (const button of buttons) {
    button.addEventListener("click", () => {
      const selected = button.dataset.filter;
      let visible = 0;
      for (const item of items) {
        const matches = selected === "all" || item.dataset.desk === selected;
        item.hidden = !matches;
        if (matches) visible += 1;
      }
      for (const season of seasons) {
        const any = season.querySelectorAll<HTMLElement>("[data-desk]:not([hidden])").length > 0;
        season.hidden = !any;
      }
      for (const candidate of buttons) {
        const active = candidate === button;
        candidate.setAttribute("aria-pressed", String(active));
        candidate.classList.toggle("button-secondary", active);
        candidate.classList.toggle("button-quiet", !active);
      }
      if (status) status.textContent = `Widoczne noce: ${visible}.`;
    });
  }
</script>
