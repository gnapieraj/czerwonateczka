---
interface Props {
  name: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  sizes: string;
  eager?: boolean;
}

const {
  name,
  alt,
  class: className,
  width = 1400,
  height = 900,
  sizes,
  eager = false,
} = Astro.props;
---

<img
  class={className}
  src={`/assets/${name}.webp`}
  srcset={`/assets/${name}-720.webp 720w, /assets/${name}-1000.webp 1000w, /assets/${name}.webp 1400w`}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={eager ? "high" : undefined}
/>
